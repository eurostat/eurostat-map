{
    "//": "Checks the published typings as a consumer without skipLibCheck sees them (skipLibCheck hides errors in .d.ts files)",
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2020", "DOM"],
        "types": [],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": false
    },
    "include": ["src/types/**/*.d.ts"]
}
